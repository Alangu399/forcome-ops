# Use one tested Zabbix release line for server, web, agents, and templates.
ZABBIX_IMAGE_TAG=alpine-7.0-latest
POSTGRES_IMAGE_TAG=16-alpine

POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD_FILE=./secrets/postgres_password

# Keep the UI local until an internal IP or HTTPS reverse proxy is configured.
ZABBIX_WEB_BIND=127.0.0.1
ZABBIX_WEB_PORT=8080

# Active agents connect to this published port.
ZABBIX_SERVER_BIND=0.0.0.0
ZABBIX_SERVER_PORT=10051

PHP_TZ=Asia/Shanghai
ZBX_SERVER_NAME=Forcome Monitoring

# Forcome Ops console. Use a dedicated read-only Zabbix account in production.
FORCOME_WEB_BIND=127.0.0.1
FORCOME_WEB_PORT=8090
ZABBIX_API_USER=Admin
ZABBIX_API_PASSWORD=
ONLINE_GRACE_SECONDS=180
CPU_WARNING_THRESHOLD=80
MEMORY_WARNING_THRESHOLD=90
DISK_WARNING_THRESHOLD=80

# DingTalk group robot. Keep real values only in the ignored .env file.
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
ALERT_CHECK_INTERVAL_SECONDS=30
